#!/bin/sh
set -e
cd "$(dirname "$0")"

# ONE step, on purpose: nothing may run before the CLI process. This used to
# `bun install --silent` first, and a failed install aborted the wrapper (set -e)
# before `exec`, printing nothing — every subcommand then looked like it had
# failed on its own. Dependencies are now installed INSIDE the CLI, by the
# bootstrap in bin/index.ts (ensureDeps), which can attribute its own failures.
# Do not add a step above the exec — except the naming just before it, which
# cannot abort (every command in it is a condition; a miss falls through to
# plain `bun`), and this one guard, which cannot fail silently: with no Bun there is no CLI to report anything, and `exec` would say
# only "bun: not found". The doctor names everything else that is missing too.
command -v bun >/dev/null 2>&1 || {
  echo "equin: bun not found — nothing can run without it." >&2
  sh plugins/framework/plugins/cli/plugins/doctor/doctor.sh >&2
  exit 1
}
# The process's name in Activity Monitor: `equin · <verb>`, not `bun`
# (packages/process-name). Run through an APFS clone of the checkout's Bun in
# `verbs` — a symlink the CLI points at the machine-wide clones of that Bun
# version, so each verb's name is made (and scanned by macOS, ~1 s on its first
# exec) once per machine, not once per checkout. The CLI records the checkout's
# Bun (it knows the real binary behind mise's shim), trusted only while its stamp
# is newer than mise.lock. A clone, never a hardlink: macOS SIGKILLs an exec
# whose inode it resolves to a deleted name (process-name's CLAUDE.md). A clone
# keeps the source's mtime, so the name is current while it is not the same file
# as `bun` and neither is newer — re-cloned only then.
# Builtins plus `cp`: on any miss — none recorded, a toolchain change, a
# refused clone — it is the plain `bun` below, and that run records it again.
names=node_modules/.cache/equin-bun
case "${1:-}" in
  "" | *[!a-z0-9-]*) verb=cli ;;
  *) verb=$1 ;;
esac
named="$names/verbs/equin · $verb"
if [ -f "$names/bun" ] && [ -d "$names/verbs" ] && [ "$names/stamp" -nt mise.lock ]; then
  if { [ -f "$named" ] && ! [ "$named" -ef "$names/bun" ] &&
    ! [ "$named" -nt "$names/bun" ] && ! [ "$names/bun" -nt "$named" ]; } ||
    { cp -c "$names/bun" "$named.$$" 2>/dev/null && mv -f "$named.$$" "$named"; }; then
    exec "$named" plugins/framework/plugins/cli/bin/index.ts "$@"
  fi
  rm -f "$named.$$"
fi
exec bun plugins/framework/plugins/cli/bin/index.ts "$@"

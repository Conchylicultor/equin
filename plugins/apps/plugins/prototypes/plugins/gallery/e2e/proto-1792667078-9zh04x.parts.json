{
  "proto": "proto-1792667078-9zh04x",
  "appSetup": [
    {
      "when": {
        "layout": "gallery"
      },
      "goto": "/prototypes;view=gallery",
      "note": "the mock's gallery layout is the Gallery view, opened by address so the device's last pick cannot decide"
    },
    {
      "when": {
        "layout": "list"
      },
      "goto": "/prototypes;view=recently-edited",
      "note": "the mock's list layout is its Recently edited view, opened by address"
    }
  ],
  "parts": [
    {
      "part": "pane.header",
      "mock": ".phead",
      "when": {
        "header": "split"
      },
      "props": [
        "box",
        "padding"
      ],
      "note": "the mock spaces the title with its own margin (gap 4 + 4), the app with the bar's gap 8: title x compared below; the mock paints the ground behind its header, the app's is transparent over the same ground"
    },
    {
      "part": "pane.title",
      "mock": ".phead .crumb",
      "when": {
        "header": "split"

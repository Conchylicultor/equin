{
  "name": "singularity",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": ["plugins/**"],
  "scripts": {
    "playwright": "playwright",
    "test:dom": "vitest run",
    "postinstall": "bun plugins/framework/plugins/tooling/plugins/provision/scripts/run-provisions.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify-json/lucide": "^1.2.144",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/material-symbols-light": "^1.2.96",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify/types": "^2.0.0",
    "@parcel/watcher": "^2.6.0",
    "@tanstack/react-query": "^5.104.3",
    "@xyflow/react": "^12.3.5",
    "dagre": "^0.8.5",
    "drizzle-orm": "^0.36.0",
    "jsonc-parser": "^3.3.1",
    "drizzle-zod": "^0.5.1",
    "pg": "^8.13.0",
    "fractional-indexing": "^3.2.0",
    "react": "^19.1.0",
    "diff": "^7.0.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^4.10.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.24.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/dagre": "^0.7.52",
    "@types/diff": "^7.0.0",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@typescript-eslint/utils": "^8.59.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.4.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.4"
  },
  "dependencyPolicy": {
    "ownScopes": ["@equin"],
    "groups": [
      {
        "id": "typescript-eslint",
        "members": [
          "@typescript-eslint/eslint-plugin",
          "@typescript-eslint/parser",
          "@typescript-eslint/utils"
        ],
        "agree": "version",
        "reason": "one copy of the typescript-eslint types: two resolved versions' types do not assign to each other (8dae82bd2b)"
      }
    ],
    "holds": [
      {
        "names": ["typescript"],
        "below": "7.0.0",
        "reason": "TypeScript 7.0 ships no programmatic compiler API (its main entry exports only `version`; the API is under `typescript/unstable/*` until 7.1). typescript-eslint, which runs our type-aware lint in the type-check check, does not support TS 7 (closed as not planned in #12518, tracked in #10940), and our 25 compiler-API users (codegen, scanners) crash on `ts.ScriptTarget`. Checked 2026-10-19 against 7.0.2: regen-generated fails with `undefined is not an object (evaluating 'ts.ScriptTarget.Latest')`. Lift when typescript-eslint supports TS 7.",
        "issue": "https://github.com/typescript-eslint/typescript-eslint/issues/10940",
        "reviewBy": "2027-01-15"
      }
    ]
  },
  "patchedDependencies": {
    "eslint-plugin-react-hooks@7.1.1": "patches/eslint-plugin-react-hooks@7.1.1.patch"
  }
}

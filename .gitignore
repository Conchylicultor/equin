# macOS
.DS_Store

# Dependencies
node_modules/

# Secrets
.env*
*.pem

# Test output
test-results/

# Build output
dist/
dist.staging.*/
dist.live.*/
dist.old.*/
# web-core publish: `dist` is a symlink → dist.live.<pid>; `dist.swap.*` is the
# transient swap symlink. Trailing-slash patterns don't match symlinks, so these
# are listed without a slash (the anchored path covers the live `dist` symlink).
plugins/framework/plugins/web-core/dist
dist.swap.*
# `VITE_ANALYZE=1` bundle-analysis treemap output (generated, never committed).
dist.stats.html
**/.build.lock
**/.install.lock

# TypeScript
*.tsbuildinfo

# RETIRED outputs, still ignored because older checkouts hold them: the
# per-composition committed config layer the build used to bundle for a demo's
# page server (codegen's config-git-layer-gen.ts, deleted when a demo's config
# moved into its browser host, which bundles `config/` itself) — under
# `/.generated/`, and before 25df26786e at the path below. Nothing writes either
# any more; ignored so a push cannot commit a leftover copy.
/.generated/
/plugins/config_v2/web/internal/git-layer.generated.ts

# A composition's build output: its filtered registries
# (`<dir>.composition.<id>.generated.ts`, siblings of the committed
# `<dir>.generated.ts`) and its backend entry. EXACTLY the locations a build
# writes (`compositionOutputIgnorePatterns`, codegen/composition-registries),
# held equal by its `composition-outputs-ignored` check — never a broader pattern: an output
# no build writes any more must be visible to git, so `build` / `push` delete it
# instead of it hiding in every checkout forever.
/plugins/framework/plugins/server-core/bin/index.composition.*.generated.ts
/plugins/framework/plugins/server-core/core/machine.composition.*.generated.ts
/plugins/framework/plugins/server-core/core/server.composition.*.generated.ts
/plugins/framework/plugins/web-sdk/core/web.composition.*.generated.ts
/plugins/infra/plugins/asset-mirror/core/prewarm.composition.*.generated.ts
/plugins/infra/plugins/deps/core/deps.composition.*.generated.ts

# Tauri desktop shell — generated/staged artifacts (the Rust project itself is
# committed; these are produced per-release or per-build).
/tauri/src-tauri/target/
/tauri/src-tauri/resources/bundle/
/tauri/src-tauri/tauri.conf.override.json
/tauri/src-tauri/appdmg.spec.json
/tauri/src-tauri/gen/
/tauri/src-tauri/icons/

# A plugin's `rust/` crate (infra/deps' rust kind builds it into a shared cache
# target dir; this covers a `cargo` run by hand inside the crate).
plugins/**/rust/target/

# Caches
.cache/
.eslintcache

# Transient dirs created by ./equin check (e.g. migrations-in-sync)
.check-*/
# drizzle-kit's staged out-dir (migrations core `stageDrizzleOut`), removed after each run.
.drizzle-stage-*/

# v1 (Next.js) - extra lock file (uses bun.lock)
v1/package-lock.json

# Claude Code
skills-lock.json
.claude/worktrees/
# Removed checkouts awaiting deletion (worktreeTrashDir, infra/worktree): an
# untracked entry appearing mid-build fails main's main-tree guard.
.claude/worktree-trash/
# Removed checkouts' dependency stores awaiting the next checkout (depStorePoolDir, infra/worktree).
.claude/worktree-dep-stores/
# Removed checkouts' trees (with their git index) awaiting the next checkout (treePoolDir, infra/worktree).
.claude/worktree-trees/
.claude/scheduled_tasks.lock
# Guard bypass files (BYPASS_TOKENS in tooling/guards): per-checkout overrides, never committed.
.allow-*
.git-diff-main-reminded

# Python bytecode from `python/` uv projects (infra/deps python kind)
__pycache__/

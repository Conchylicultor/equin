# macOS
.DS_Store

# Dependencies
node_modules/

# Secrets
.env*
*.pem

# Test output
test-results/

# Build output
dist/
dist.staging.*/
dist.live.*/
dist.old.*/
# web-core publish: `dist` is a symlink → dist.live.<pid>; `dist.swap.*` is the
# transient swap symlink. Trailing-slash patterns don't match symlinks, so these
# are listed without a slash (the anchored path covers the live `dist` symlink).
plugins/framework/plugins/web-core/dist
dist.swap.*
# `VITE_ANALYZE=1` bundle-analysis treemap output (generated, never committed).
dist.stats.html
**/.build.lock
**/.install.lock

# TypeScript
*.tsbuildinfo

# Generated composition-module sources (web-artifacts' composition-modules.ts):
# the committed config layer of each composition, bundled for the browser server
# — regenerated by every `./singularity build` from `config/` (codegen's
# config-git-layer-gen.ts); committing it would make every config edit a second,
# conflicting generated diff.
/.generated/
# Its location before 25df26786e moved it there. Older checkouts can still hold
# an untracked copy from a pre-move build; ignored so a push cannot commit it
# (e69c28d9e9 did, and main's build — which deletes it — then failed its
# read-only-checkout guard). Drop with the rmSync in config-git-layer-gen.ts.
/plugins/config_v2/web/internal/git-layer.generated.ts

# Composition build-gating: per-worktree filtered registries emitted only by
# `./singularity build --hermetic --composition <name…>` (never committed;
# siblings of the committed `<dir>.generated.ts`). The second pattern covers the per-name
# auto-serve registries (`<dir>.composition.<name>.generated.ts`).
*.composition.generated.ts
*.composition.*.generated.ts

# Tauri desktop shell — generated/staged artifacts (the Rust project itself is
# committed; these are produced per-release or per-build).
/tauri/src-tauri/target/
/tauri/src-tauri/resources/bundle/
/tauri/src-tauri/tauri.conf.override.json
/tauri/src-tauri/appdmg.spec.json
/tauri/src-tauri/gen/
/tauri/src-tauri/icons/

# Caches
.cache/
.eslintcache

# Transient dirs created by ./singularity check (e.g. migrations-in-sync)
.check-*/
# drizzle-kit's staged out-dir (migrations core `stageDrizzleOut`), removed after each run.
.drizzle-stage-*/

# v1 (Next.js) - extra lock file (uses bun.lock)
v1/package-lock.json

# Claude Code
skills-lock.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.allow-main
.git-diff-main-reminded

# Python bytecode from `python/` uv projects (infra/deps python kind)
__pycache__/

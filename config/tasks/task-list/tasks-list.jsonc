// @hash 6ec84829688d
{
  "views": [
    {
      "id": "tree",
      "name": "Tree",
      "icon": "account-tree",
      "view": {
        "type": "table",
        "presentation": "outline",
        "columnCaptions": "shown",
        "groupBy": "category",
        "properties": [{ "id": "status" }, { "id": "title" }, { "id": "updatedAt" }],
        "filter": {
          "kind": "group",
          "id": "hide-completed",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "hide-completed-status",
              "fieldId": "status",
              "operatorId": "is-none-of",
              "value": ["done", "dropped"]
            }
          ]
        }
      }
    },
    {
      "id": "recent",
      "name": "Recent",
      "icon": "history",
      "view": {
        "type": "list",
        "columnCaptions": true,
        "sort": { "fieldId": "updatedAt", "direction": "desc" },
        "properties": [
          { "id": "status" },
          { "id": "title" },
          { "id": "track" },
          { "id": "triage" },
          { "id": "priority" },
          { "id": "taskType" },
          { "id": "category" },
          { "id": "origin" },
          { "id": "approval" },
          { "id": "updatedAt" },
          { "id": "triagedAt", "hidden": true }
        ]
      }
    },
    {
      "id": "attempted",
      "name": "Attempted",
      "icon": "play-circle",
      "view": {
        "type": "table",
        "presentation": "outline",
        "columnCaptions": "shown",
        "filter": {
          "kind": "group",
          "id": "attempted",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "attempted-status",
              "fieldId": "status",
              "operatorId": "is",
              "value": "attempted"
            }
          ]
        }
      }
    }
  ],
  "filterPresets": [
    {
      "id": "hide-completed",
      "label": "Hide completed",
      "group": {
        "kind": "group",
        "id": "hide-completed",
        "conjunction": "and",
        "children": [
          {
            "kind": "rule",
            "id": "hide-completed-status",
            "fieldId": "status",
            "operatorId": "is-none-of",
            "value": ["done", "dropped"]
          }
        ]
      }
    }
  ]
}

// @hash 81ba03048557
{
  // The menu-bar panel is drawn in its own theme, `menu-bar` (a native menu's
  // look: the system font, 13px rows, the menu palette; its app tiles keep the
  // launcher's colours), contributed by the menu-bar plugin
  // (`plugins/menu-bar/web/internal/theme.ts`) and selected here because the
  // panel is an app of its own (`menuBarApp`). Its light/dark is not here: the
  // app declares `colorMode: "light"` and the user's override lives in
  // `color-mode.jsonc`, a separate document.
  "theme": "menu-bar"
}

// @hash 81ba03048557
{
  // The launcher paints its own designed theme, `home` (a black page and the
  // ocean palette its app tiles are drawn from), contributed by the home shell
  // (`plugins/apps/plugins/home/plugins/shell/web/internal/theme.ts`) — never
  // the desktop's runtime choice. This one selection is the whole per-app
  // theme: a group `home` does not mention paints its schema defaults.
  //
  // `colorMode` is deliberately absent: an app theme document's `colorMode` is
  // never read. An app's light/dark is its `defineApp({ colorMode })` default
  // plus the user's override in `color-mode.jsonc`.
  "theme": "home"
}

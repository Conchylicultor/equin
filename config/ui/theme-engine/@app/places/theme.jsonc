// @hash 81ba03048557
{
  // Places paints its own theme, `places`, contributed by the Places shell
  // (`plugins/apps/plugins/places/plugins/shell/web/internal/theme.ts`) — never
  // the desktop's runtime choice. Light only is the app's declared
  // `colorMode: "light"` (`plugins/apps/plugins/places/plugins/shell/core/app.ts`),
  // which puts the light scheme on the app's scope for every token group.
  "theme": "places"
}

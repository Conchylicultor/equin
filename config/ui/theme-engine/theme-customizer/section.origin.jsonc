// @hash 01cd1f7a4c2a
{
  // Item: "<key>" (terse; <key> is "<pluginId>:<id>")
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
  // Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  // Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
  "items": [
    "ui.theme-engine.theme-gallery.customizer:themes",
    "ui.theme-toggle.customizer:color-mode",
    "ui.tokens.categorical.customizer:categorical",
    "ui.tokens.chart.customizer:chart",
    "ui.tokens.chord-palette.customizer:chord-palette",
    "ui.tokens.color-adjust:color-adjust",
    "ui.tokens.color-palette.customizer:color-palette",
    "ui.tokens.data-view.customizer:data-view",
    "ui.tokens.density.customizer:density",
    "ui.tokens.file-type-palette.customizer:file-type-palette",
    "ui.tokens.font-family.customizer:font-family",
    "ui.tokens.icons.customizer:icons",
    "ui.tokens.material.customizer:material",
    "ui.tokens.overlay.customizer:overlay",
    "ui.tokens.place-palette.customizer:place",
    "ui.tokens.scrollbar.customizer:scrollbar",
    "ui.tokens.shadow.customizer:shadow",
    "ui.tokens.shape.customizer:shape",
    "ui.tokens.sidebar-metrics.customizer:sidebar-metrics",
    "ui.tokens.sidebar-palette.customizer:sidebar-palette",
    "ui.tokens.spend-palette.customizer:spend-palette",
    "ui.tokens.type-scale.customizer:type-scale",
    "ui.tweakcn.community-browser.customizer:import-by-url"
  ]
}

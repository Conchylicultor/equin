// @hash 6ec84829688d
{
  // Debug → Queue → Queue: the host's live job queue (the `jobs` collection —
  // every sort / filter / group runs on the server). A job leaves it for
  // History when its run finishes.
  //
  // `state` is graphile's queue state (pending / running / retrying / dead);
  // `runAt` the one sort (the queue's keyset).
  "views": [
    {
      "id": "all",
      "name": "All",
      "icon": "list",
      "view": { "type": "table", "sort": [{ "fieldId": "runAt", "direction": "desc" }] }
    },
    {
      // What is in flight right now.
      "id": "active",
      "name": "Active",
      "icon": "play-circle",
      "view": {
        "type": "table",
        "sort": [{ "fieldId": "runAt", "direction": "asc" }],
        "filter": {
          "kind": "group",
          "id": "f-active",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "r-active",
              "fieldId": "state",
              "operatorId": "is-any-of",
              "value": ["pending", "running", "retrying"]
            }
          ]
        }
      }
    },
    {
      // Rows that need a look: retrying (waiting on a backoff) or dead.
      "id": "failed",
      "name": "Failed",
      "icon": "error",
      "view": {
        "type": "table",
        "sort": [{ "fieldId": "runAt", "direction": "desc" }],
        "filter": {
          "kind": "group",
          "id": "f-failed",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "r-failed-state",
              "fieldId": "state",
              "operatorId": "is-any-of",
              "value": ["retrying", "dead"]
            }
          ]
        }
      }
    },
    {
      "id": "by-job",
      "name": "By job",
      "icon": "workspaces",
      "view": {
        "type": "table",
        "properties": [{ "id": "state" }, { "id": "hold" }, { "id": "attempts" }, { "id": "runAt" }, { "id": "lastError" }],
        "groupBy": { "fieldId": "jobName", "groupingId": "value" },
        "sort": [{ "fieldId": "runAt", "direction": "desc" }]
      }
    }
  ],
  "sortPresets": [],
  "filterPresets": [],
  "customColumns": []
}

// @hash 2ae4043ce7ef
// @legend — how to write this file (rewritten by ./equin build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
{
  // Hide: { "item": "<key>", "hidden": true }. Gap: { "type": "spacer", "id": "<unique-id>" }.
  // Home leads the rail: it is the composition's home app — the launcher mark
  // itself, never a tile — so every launcher list starts at Agent Manager.
  // The user's chosen order follows: Agent Manager, Pages, Sonata, Places,
  // Prototypes, Files, Keyboard Party, Desktop, Settings. Desktop switches the
  // surface into the desktop (windows + shelf) rather than opening an app.
  // Every other app comes after Settings, in its previous relative order:
  // the content apps (Mail, Events — fed by external sources, beside Mail —
  // Chord, Browser), then the spacer, then developer and system tooling
  // (Studio, Website, Demo — temporary, right after the Website it is headed
  // for — Deploy, Debug).
  "items": [
    "apps.home.shell:home",
    "apps.agent-manager.shell:agent-manager",
    "apps.pages.shell:pages",
    "apps.sonata.shell:sonata",
    "apps.places.shell:places",
    "apps.prototypes.shell:prototypes",
    "apps.file-explorer.shell:file-explorer",
    "apps.keyboard-party.shell:keyboard-party",
    "apps.desktop.shell:desktop",
    "apps.settings.shell:settings",
    "apps.mail.shell:mail",
    "apps.events.shell:events",
    "apps.chord.shell:chord",
    "apps.browser.shell:browser",
    { "type": "spacer", "id": "spacer-1" },
    "apps.studio.shell:studio",
    "apps.website.shell:website",
    "apps.demo.shell:demo",
    "apps.deploy.shell:deploy",
    "apps.debug.shell:debug",
    // The menu-bar panel is an app only so it can wear its own light/dark; it
    // is unlisted (`defineApp({ listed: false })`) — the native helper opens it.
    { "item": "menu-bar:menu-bar", "hidden": true }
  ]
}

// @hash 4656c5bd440b
// @legend — how to write this file (rewritten by ./equin build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
{
  // Vertical list of rows in the action bar's gear popover, read top → bottom:
  // who the user is (Developer mode) first, then how the tab is laid out, the
  // whole-window toggle, this page in its app's own window (macOS browser
  // tabs; with Developer mode, the only rows a regular user sees), the
  // experimental-build marks (shown on an experimental build only), and the
  // developer's preview of the app as a new user sees it (git defaults).
  "items": [
    "audience.view-option:developer-mode",
    "apps-core.surface:placement-control",
    "fullscreen:fullscreen-toggle",
    "menu-bar.open-in-window:open-in-window",
    "framework.cli.build.experimental-marks:experimental-marks",
    "config_v2.git-defaults-preview:git-defaults-preview"
  ]
}

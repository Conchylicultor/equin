// @hash 32b53cf952ff
// @legend — how to write this file (rewritten by ./equin build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// The health report's rows, top to bottom. The report puts info rows first and
// folds the plain rows that are fine into one card at the end, whatever this order;
// this is the order everything else keeps — never by status, so a row stays put
// when it turns red.
{
  "items": [
    // Where you are: the report's heading.
    "tasks.worktree-identity:worktree",
    // "Can this app run an agent at all": the first thing a new user needs answered.
    "conversations.runtime-sdk:claude-code",
    // Can I reach the server ...
    "infra.health:connection",
    // ... and is the server reaching its database.
    "database.query-deadline:database",
    // The server's own work.
    "debug.queue-health:job-queue",
    // About the whole machine, not the server you are on.
    "debug.sentinel:machine-watcher",
    // The socket is up and the server reaches its database, and yet a read can still fail.
    "reports.resource-errors:live-reads",
    // The infrastructure the page runs on, ending with the front door's own currency.
    "infra.launcher.gateway-drift:gateway",
    // The server agents launched from here call back into.
    "infra.mcp.health:mcp-server",
    // A tool agents use, not the app itself.
    "infra.mcp.browser:agent-browser",
    // This browser's own storage.
    "primitives.dom.web-storage.health:browser-storage"
  ]
}

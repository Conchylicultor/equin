// @hash 2296b32756f9
// @legend — how to write this file (rewritten by ./singularity build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// Arrange "items" for how this slot ACTUALLY renders — a sidebar is a
// vertical list, a toolbar a horizontal bar, a pane a stack of blocks.
// Look at the surface, then order for that reading direction.
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
// Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// The Sonata player's toolbar pill, read left to right (the header band's
// identity — back, the song title — sits left of it, outside the slot).
// Playback itself — play / pause, the time, the chord timeline, loop — is the
// progression capsule under it (`config/apps/sonata/player/transport.jsonc`),
// not this row.
//
// First which view it is (the display switcher), then, after a divider, the
// tools, each named for its role: time — how fast (the speed wheel) and the
// beat that goes with it (the metronome) — then pitch (transpose), then output
// (volume), then the view's zoom (the spread wheel, piano roll only); and after
// a second divider, full screen. The wheels and volume fold to icon + value at
// rest and open on hover, so the pill stays short.
//
// The pane's own title item is hidden: the band draws the title itself.
//
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// At most one spacer per slot.
{
  "items": [
    { "item": "primitives.pane:title", "hidden": true },
    "apps.sonata.library:display-picker",
    { "type": "divider", "id": "divider-view" },
    "apps.sonata.transport-bar:speed",
    "apps.sonata.audio.metronome:metronome",
    "apps.sonata.transpose:transpose",
    "apps.sonata.audio.engine:volume",
    "apps.sonata.piano-roll:spread",
    { "type": "divider", "id": "divider-screen" },
    "apps.sonata.library:fullscreen"
  ]
}

// @hash 6ec84829688d
{
  "views": [
    {
      "id": "cards",
      "name": "Cards",
      "icon": "grid-view",
      "icon": "grid-view",
      "view": {
        "type": "gallery",
        "groupBy": "source",
        // Authored, not defaulted: the schema is every field the songs
        // entity and its extensions expose, and the card shows only these —
        // the title, the composer or the grid's chords as the subtitle,
        // length / plays / last played / tracks as icon tokens (a chord sheet's key
        // is its cover's badge), and the missing-file mark on the title line.
        // The rest stay filter/sort dimensions (and table columns).
        "properties": [
          { "id": "title" },
          { "id": "composer" },
          { "id": "chordText" },
          { "id": "duration" },
          { "id": "playCount" },
          { "id": "lastPlayedAt" },
          { "id": "trackCount" },
          { "id": "sourceMissing" }
        ]
      }
    },
    {
      "id": "all",
      "name": "All",
      "icon": "library-music",
      "icon": "library-music",
      "view": { "type": "list", "sort": { "fieldId": "title", "direction": "asc" } }
    },
    {
      "id": "longest",
      "name": "Longest",
      "icon": "timer",
      "icon": "timer",
      "view": { "type": "list", "sort": { "fieldId": "duration", "direction": "desc" } }
    },
    {
      "id": "composed",
      "name": "Composed",
      "icon": "music-note",
      "icon": "music-note",
      "view": {
        "type": "table",
        "filter": {
          "kind": "group",
          "id": "f-composed",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "r-composer",
              "fieldId": "composer",
              "operatorId": "is-not-empty"
            }
          ]
        }
      }
    },
    {
      // The id the user's own "Recent" view already carries, so this row and
      // theirs are one view.
      "id": "view-127a0cb8-0e15-497f-8145-41d97ee37e90",
      "name": "Recent",
      "icon": "history",
      "view": {
        "type": "list",
        "sort": [{ "fieldId": "added", "direction": "desc" }]
      }
    }
  ],
  "sortPresets": [
    {
      "label": "Title A→Z",
      "rules": [{ "fieldId": "title", "direction": "asc" }]
    },
    {
      "label": "Longest first",
      "rules": [{ "fieldId": "duration", "direction": "desc" }]
    },
    {
      "label": "Newest",
      "rules": [{ "fieldId": "added", "direction": "desc" }]
    },
    {
      "label": "Most played",
      "rules": [{ "fieldId": "playCount", "direction": "desc" }]
    },
    {
      "label": "Recently played",
      "rules": [{ "fieldId": "lastPlayedAt", "direction": "desc" }]
    }
  ],
  "filterPresets": [
    {
      "label": "Unplayed",
      "group": {
        "kind": "group",
        "id": "fp-unplayed",
        "conjunction": "and",
        "children": [
          {
            "kind": "rule",
            "id": "fp-unplayed-r1",
            "fieldId": "playCount",
            "operatorId": "=",
            "value": 0
          }
        ]
      }
    }
  ]
}

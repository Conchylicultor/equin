// @hash 6ec84829688d
// The gallery is grouped by `tag`: sections NEST along the prototypes' tag
// tree (app ▸ website ▸ homepage), each header counting its whole subtree, a
// parent's own cards above its child sections, the untagged ones last
// ("None"). Within a section the cards sort by `status` — the pinned ones
// first, then the ones still being worked on, the finished ones last (Done
// cards also read muted). DESCENDING because an enum sorts by its VALUE, not
// its options order: "pinned" > "in-progress" > "done". Group by Status
// instead for the old Pinned / In progress / Done sections. Every view binds
// to a source: `gallery` (the live
// prototypes) or `trash` (the deleted ones, Restore on each card).
{
  "views": [
    {
      "id": "gallery",
      "name": "Gallery",
      "icon": "grid-view",
      "source": "gallery",
      "view": {
        "type": "gallery",
        "groupBy": { "fieldId": "tag", "groupingId": "tree" },
        "sort": [{ "fieldId": "status", "direction": "desc" }],
        // Authored, not defaulted: each card is the prototype's picture, its
        // title (with the problems mark after it), the blurb as the subtitle,
        // and when it was last edited and how many versions it has as tokens.
        // The rest stay sort and filter dimensions.
        "properties": [
          { "id": "title" },
          { "id": "problems" },
          { "id": "blurb" },
          { "id": "modifiedAt" },
          { "id": "versions" }
        ]
      }
    },
    {
      // The same prototypes as one list, the most recently edited first —
      // "what was I working on", without the tag sections. Drawn as the
      // soft table (the gallery mock's list): each row's picture, the title
      // over the blurb, then when it was edited and its version count.
      "id": "recently-edited",
      "name": "Recently edited",
      "icon": "schedule",
      "source": "gallery",
      "view": {
        "type": "table",
        "presentation": "soft",
        "cover": true,
        "titleCell": "stacked",
        "sort": [{ "fieldId": "modifiedAt", "direction": "desc" }]
      }
    },
    {
      // Deleted prototypes as the gallery draws them, the most recently
      // deleted first, with when each was deleted as a token.
      "id": "trash",
      "name": "Trash",
      "icon": "delete",
      "source": "trash",
      "view": {
        "type": "gallery",
        "sort": [{ "fieldId": "deletedAt", "direction": "desc" }],
        "properties": [
          { "id": "title" },
          { "id": "problems" },
          { "id": "blurb" },
          { "id": "deletedAt" },
          { "id": "versions" }
        ]
      }
    }
  ]
}

// @hash 6ec84829688d
// The gallery is grouped by `status`: the pinned prototypes come first
// ("Pinned"), then the ones still being worked on ("In progress"), the finished
// ones last ("Done"). Done cards also read
// muted, so the second section is visibly a pile you are finished with rather
// than more of the same.
{
  "views": [
    {
      "id": "gallery",
      "name": "Gallery",
      "icon": "grid-view",
      "icon": "grid-view",
      "view": {
        "type": "gallery",
        "groupBy": { "fieldId": "status", "groupingId": "value" },
        // Authored, not defaulted: each card is the prototype's picture, its
        // title (with the problems mark after it), the blurb as the subtitle,
        // and when it was last edited and how many versions it has as tokens.
        // The rest stay sort and filter dimensions.
        "properties": [
          { "id": "title" },
          { "id": "problems" },
          { "id": "blurb" },
          { "id": "modifiedAt" },
          { "id": "versions" }
        ]
      }
    },
    {
      // The same prototypes as one list, the most recently edited first —
      // "what was I working on", without the status sections.
      "id": "recently-edited",
      "name": "Recently edited",
      "icon": "schedule",
      "view": {
        "type": "list",
        "sort": [{ "fieldId": "modifiedAt", "direction": "desc" }]
      }
    }
  ]
}

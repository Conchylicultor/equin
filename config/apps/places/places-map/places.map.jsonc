// @hash 6ec84829688d
{
  // Map first: the landing view is every place on the map, the screen's
  // canvas. Gallery and List are the same rows read another way — the tag
  // sidebar's filter is per view, so each starts unfiltered.
  "views": [
    {
      "id": "all",
      "name": "All places",
      "icon": "map",
      "view": { "type": "map" }
    },
    {
      "id": "gallery",
      "name": "Gallery",
      "icon": "grid-view",
      "view": {
        "type": "gallery",
        // The fields in reading order: the place's name first, then the stored
        // fields the list derives, then its own yes / no flags — the list's
        // computed fields would otherwise follow every derived one.
        "properties": [
          { "id": "name" },
          { "id": "address" },
          { "id": "tags" },
          { "id": "want" },
          { "id": "been" },
          { "id": "businessStatus", "hidden": true },
          { "id": "googleLost", "hidden": true },
          { "id": "location", "hidden": true },
          { "id": "note", "hidden": true },
          { "id": "createdAt", "hidden": true }
        ],
        "sort": [{ "fieldId": "createdAt", "direction": "desc" }]
      }
    },
    {
      "id": "list",
      "name": "List",
      "icon": "list",
      "view": {
        "type": "list",
        // The fields in reading order: the place's name first, then the stored
        // fields the list derives, then its own yes / no flags — the list's
        // computed fields would otherwise follow every derived one.
        "properties": [
          { "id": "name" },
          { "id": "address" },
          { "id": "tags" },
          { "id": "want" },
          { "id": "been" },
          { "id": "businessStatus", "hidden": true },
          { "id": "googleLost", "hidden": true },
          { "id": "location", "hidden": true },
          { "id": "note", "hidden": true },
          { "id": "createdAt", "hidden": true }
        ],
        "sort": [{ "fieldId": "name", "direction": "asc" }]
      }
    }
  ]
}

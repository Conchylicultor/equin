// @hash 6ec84829688d
{
  // The side panel beside the map: the active preset's places as a list or a
  // gallery. The panel pins the view its layout names (list | gallery), so
  // there is no switcher; the preset's filter, search AND sort are applied
  // before the rows reach it — so no view here sorts (a sort of its own would
  // override the toolbar's Sort, which edits the preset).
  "views": [
    {
      "id": "gallery",
      "name": "Gallery",
      "icon": "grid-view",
      "view": {
        "type": "gallery",
        // A poster card (the panel's `viewOptions`): the place's photo with
        // its name and "type · address" written on it, then the user's note
        // as the card's excerpt and the tags as chips. Want to go / Been are
        // the pills the cover draws itself, so the two flags are hidden.
        "properties": [
          { "id": "glyph" },
          { "id": "tile", "hidden": true },
          { "id": "name" },
          { "id": "kind", "slot": "line2" },
          { "id": "address", "slot": "line2" },
          { "id": "note", "slot": "excerpt" },
          { "id": "tags" },
          { "id": "want", "hidden": true },
          { "id": "been", "hidden": true },
          { "id": "status", "hidden": true },
          { "id": "businessStatus", "hidden": true },
          { "id": "googleLost", "hidden": true },
          { "id": "location", "hidden": true },
          { "id": "createdAt", "hidden": true }
        ]
      }
    },
    {
      "id": "list",
      "name": "List",
      "icon": "list",
      "view": {
        "type": "list",
        // The fields in reading order: the place's name first, then the stored
        // fields the list derives, then its own yes / no flags — the list's
        // computed fields would otherwise follow every derived one. The row
        // leads with the place's tile, the address and the tags each on a
        // line under the name (the record recipe would trail both — rigid
        // slots wider than the panel, leaving the name no room), and Want to
        // go / Been as one status on the right (the glyph and the two flags
        // are the gallery's). The slots are this view's own: the gallery's
        // card keeps its layout.
        "properties": [
          { "id": "tile", "slot": "lead" },
          { "id": "name" },
          { "id": "address", "slot": "line2" },
          { "id": "tags", "slot": "line2" },
          { "id": "status", "slot": "trail" },
          { "id": "glyph", "hidden": true },
          { "id": "kind", "hidden": true },
          { "id": "want", "hidden": true },
          { "id": "been", "hidden": true },
          { "id": "businessStatus", "hidden": true },
          { "id": "googleLost", "hidden": true },
          { "id": "location", "hidden": true },
          { "id": "note", "hidden": true },
          { "id": "createdAt", "hidden": true }
        ]
      }
    }
  ]
}

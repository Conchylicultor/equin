// @hash 6ec84829688d
{
  // The side panel beside the map: the active preset's places as a list or a
  // gallery. The panel pins the view its layout names (list | gallery), so
  // there is no switcher; the preset's filter, search AND sort are applied
  // before the rows reach it — so no view here sorts (a sort of its own would
  // override the toolbar's Sort, which edits the preset).
  "views": [
    {
      "id": "gallery",
      "name": "Gallery",
      "icon": "grid-view",
      "view": {
        "type": "gallery",
        // The fields in reading order: the place's name first, then the stored
        // fields the list derives, then its own yes / no flags — the list's
        // computed fields would otherwise follow every derived one.
        "properties": [
          { "id": "name" },
          { "id": "address" },
          { "id": "tags" },
          { "id": "want" },
          { "id": "been" },
          { "id": "businessStatus", "hidden": true },
          { "id": "googleLost", "hidden": true },
          { "id": "location", "hidden": true },
          { "id": "note", "hidden": true },
          { "id": "createdAt", "hidden": true }
        ]
      }
    },
    {
      "id": "list",
      "name": "List",
      "icon": "list",
      "view": {
        "type": "list",
        // The fields in reading order: the place's name first, then the stored
        // fields the list derives, then its own yes / no flags — the list's
        // computed fields would otherwise follow every derived one.
        "properties": [
          { "id": "name" },
          { "id": "address" },
          { "id": "tags" },
          { "id": "want" },
          { "id": "been" },
          { "id": "businessStatus", "hidden": true },
          { "id": "googleLost", "hidden": true },
          { "id": "location", "hidden": true },
          { "id": "note", "hidden": true },
          { "id": "createdAt", "hidden": true }
        ]
      }
    }
  ]
}

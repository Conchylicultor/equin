// @hash 6ec84829688d
{
  // One table: the tag tree as rows, in the tree's own depth-first order (a
  // hierarchy over the tag collection). No sort on purpose — a sorted column would scatter the
  // children away from their parents and lose the indentation's meaning.
  "views": [
    {
      "id": "tags",
      "name": "Tags",
      "icon": "sell",
      "view": {
        "type": "table",
        // The columns in reading order (the parent sits before the Google
        // types, though the list derives the types and computes the parent).
        "properties": [
          { "id": "name" },
          { "id": "parent" },
          { "id": "googleTypes" },
          { "id": "places" },
          { "id": "actions" }
        ]
      }
    }
  ]
}

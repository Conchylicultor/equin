// @hash fcf7fc565976
{
  // Which archipelago the apps are placed on. Each seed keeps its own town.
  "seed": 1,
  // Follow the clock, or hold the island at one time of day.
  // Allowed values: "auto", "day", "dusk", "night"
  "time": "auto",
  // Play generative music while you walk the island.
  "music": true,
  // The kind of music the island plays: one that matches the time of day (a lo-fi afternoon, a bossa at golden hour, a nocturne at night), or always the same.
  // Allowed values: "auto", "lofi", "bossa", "nocturne", "ambient"
  "mood": "auto"
}

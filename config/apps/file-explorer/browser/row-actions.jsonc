// @hash 80a3aad8adc4
// @legend — how to write this file (rewritten by ./equin build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
{
  // Extract here is the one action worth a glance on the row (it shows only on
  // archives); every other action waits behind the row's `⋯`, in the Finder's
  // order. The row's right-click menu draws this same list, in this order, as
  // menu items.
  "items": [
    "apps.file-explorer.browser:extract",
    {
      "type": "overflow",
      "id": "row-overflow",
      "items": [
        "apps.file-explorer.browser:open",
        "apps.file-explorer.browser:reveal",
        "apps.file-explorer.browser:rename",
        "apps.file-explorer.browser:copy",
        "apps.file-explorer.browser:cut",
        "apps.file-explorer.browser:compress",
        "apps.file-explorer.browser:copy-path",
        "apps.file-explorer.places:add-to-favorites",
        "apps.file-explorer.browser:trash",
        "apps.file-explorer.browser:delete"
      ]
    }
  ]
}

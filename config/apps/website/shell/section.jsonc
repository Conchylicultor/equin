// @hash 78594e415dac
// @legend — how to write this file (rewritten by ./equin build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// Arrange "items" for how this slot ACTUALLY renders — a sidebar is a
// vertical list, a toolbar a horizontal bar, a pane a stack of blocks.
// Look at the surface, then order for that reading direction.
// Node forms:
// Item: "<key>" (terse; <key> is "<pluginId>:<id>")
// Hide: { "item": "<key>", "hidden": true }
// Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
// Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
// Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// At most one spacer per slot.
{
  // The homepage, top to bottom. This order is the page's argument, so it lives
  // here rather than falling out of the plugin load order (which would open the
  // page with the contact block — see the origin beside this file):
  //
  //   hero       — what equin is, in one sentence, and its three properties.
  //   screenshot — what that looks like: equin in desktop mode.
  //   layers     — what equin is made of, each layer opening its own page.
  //   story-link — the quieter door, for the context behind the project.
  //   contact    — and if you got this far, how to reach the project.
  //
  // Nothing may come after contact: the page ends where the reader acts.
  "items": [
    "apps.website.landing.hero:hero",
    "apps.website.landing.screenshot:screenshot",
    "apps.website.landing.layers:layers",
    "apps.website.landing.story-link:story-link",
    "apps.website.landing.contact:contact"
  ]
}

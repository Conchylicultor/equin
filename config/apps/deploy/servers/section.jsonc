// @hash 83b9ffc219f1
// @legend — how to write this file (rewritten by ./equin build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
// The server page, two columns (each section declares its `column`; this
// order is read within each column).
//
//   main: deployments (what this server serves — the reason anyone opens the
//         page, so it leads), identity (the record: name / host / user / port /
//         console), danger-zone (Delete, last).
//   side: status (liveness, qualifying everything else), ssh-setup (the key
//         flow — converge and ship refuse until a probe succeeds, so it sits
//         beside the sites from the first read).
{
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" }
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  "items": [
    "apps.deploy.deployments:deployments",
    "apps.deploy.servers:identity",
    "apps.deploy.health:status",
    "apps.deploy.ssh-setup:ssh-setup",
    "apps.deploy.servers:danger-zone"
  ]
}

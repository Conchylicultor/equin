// @hash 6ec84829688d
{
  "views": [
    // One row per secret the deployment's composition needs: the key, where it
    // stands (approved / new / value changed / missing value), who asked for it
    // and why. Set value and Approve are the row's trailing actions. A table, so
    // the key never truncates behind a long description.
    {
      "id": "secrets",
      "name": "Secrets",
      "view": {
        "type": "table",
        "properties": [
          { "id": "key" },
          { "id": "status" },
          { "id": "plugin" },
          { "id": "description" }
        ]
      }
    }
  ]
}

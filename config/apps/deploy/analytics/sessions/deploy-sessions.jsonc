// @hash 6ec84829688d
{
  // The Sessions tab's views: every visit, newest first, grouped by the day it
  // started — each row the visit's lane, opening onto its timeline. One view
  // per shape (All / With actions / 2+ pages / Bounced: the report's bounce,
  // one pageview), each a saved filter run on this computer's copy of the
  // site's analytics. Every view starts on the site's visitors (`owner` is
  // false: the owner's own visits left out, as in the report) — the toolbar's
  // quick filters switch it (and the device); editing any rule is a draft of
  // the view, carried in the page's URL. No date range: the list pages back
  // through time as it scrolls.

  "views": [
    {
      "id": "all",
      "name": "All",
      "icon": "timeline",
      "source": "visits",
      "view": {
        "type": "list",
        "sort": [
          {
            "fieldId": "startedAt",
            "direction": "desc"
          }
        ],
        "groupBy": {
          "fieldId": "startedAt",
          "groupingId": "day"
        },
        "filter": {
          "kind": "group",
          "id": "f-all",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "r-visitors",
              "fieldId": "owner",
              "operatorId": "is",
              "value": false
            }
          ]
        }
      }
    },
    {
      "id": "actions",
      "name": "With actions",
      "icon": "bolt",
      "source": "visits",
      "view": {
        "type": "list",
        "sort": [
          {
            "fieldId": "startedAt",
            "direction": "desc"
          }
        ],
        "groupBy": {
          "fieldId": "startedAt",
          "groupingId": "day"
        },
        "filter": {
          "kind": "group",
          "id": "f-actions",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "r-visitors",
              "fieldId": "owner",
              "operatorId": "is",
              "value": false
            },
            {
              "kind": "rule",
              "id": "r-actions",
              "fieldId": "events",
              "operatorId": ">",
              "value": 0
            }
          ]
        }
      }
    },
    {
      "id": "multi",
      "name": "2+ pages",
      "icon": "layers",
      "source": "visits",
      "view": {
        "type": "list",
        "sort": [
          {
            "fieldId": "startedAt",
            "direction": "desc"
          }
        ],
        "groupBy": {
          "fieldId": "startedAt",
          "groupingId": "day"
        },
        "filter": {
          "kind": "group",
          "id": "f-multi",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "r-visitors",
              "fieldId": "owner",
              "operatorId": "is",
              "value": false
            },
            {
              "kind": "rule",
              "id": "r-multi",
              "fieldId": "pageviews",
              "operatorId": "≥",
              "value": 2
            }
          ]
        }
      }
    },
    {
      "id": "bounced",
      "name": "Bounced",
      "icon": "logout",
      "source": "visits",
      "view": {
        "type": "list",
        "sort": [
          {
            "fieldId": "startedAt",
            "direction": "desc"
          }
        ],
        "groupBy": {
          "fieldId": "startedAt",
          "groupingId": "day"
        },
        "filter": {
          "kind": "group",
          "id": "f-bounced",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "r-visitors",
              "fieldId": "owner",
              "operatorId": "is",
              "value": false
            },
            {
              "kind": "rule",
              "id": "r-bounced",
              "fieldId": "pageviews",
              "operatorId": "=",
              "value": 1
            }
          ]
        }
      }
    }
  ],
  "sortPresets": [],
  "filterPresets": [],
  "customColumns": []
}

// @hash 01e08988b4ba
// @legend — how to write this file (rewritten by ./equin build; edits inside this block are lost):
//   Item: "<key>" (terse; <key> is "<pluginId>:<id>")
//   Hide: { "item": "<key>", "hidden": true }
//   Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
//   Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
//   Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
//   Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
{
  // The conversation sidebar is a narrow column and these rows already carry a
  // title, chips and a status dot, so only Pin and Move to — the actions a
  // user reaches for repeatedly while triaging the queue into sections — keep
  // an inline icon (Move to is itself a menu, so it cannot fold into the `⋯`).
  // The queue moves and Close fold behind the row's single `⋯`. This split is a judgement
  // about THIS surface's width; it is authored, never inferred.
  "items": [
    "conversations.conversations-view.data-view.queue:pin",
    "conversations.conversations-view.data-view.queue:move-to",
    {
      "type": "overflow",
      "id": "row-overflow",
      "items": [
        "conversations.conversations-view.data-view.queue:promote",
        "conversations.conversations-view.data-view.queue:step-down",
        "conversations.conversations-view.data-view.queue:demote",
        "conversations.conversations-view.data-view.queue:add-to-queue",
        "conversations.conversations-view.data-view.queue:close"
      ]
    }
  ]
}

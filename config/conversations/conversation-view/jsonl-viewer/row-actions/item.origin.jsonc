// @hash 48f69d50a19e
{
  // Item: "<key>" (terse; <key> is "<pluginId>:<id>")
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
  // Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  // Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
  "items": [
    "conversations.conversation-view.jsonl-viewer:timestamp",
    "conversations.conversation-view.jsonl-viewer:raw-json",
    "conversations.conversation-view.jsonl-viewer.assistant-text:markdown-toggle",
    "conversations.conversation-view.jsonl-viewer.assistant-text:copy-assistant-text",
    "conversations.conversation-view.jsonl-viewer.investigate-event:investigate-event",
    "conversations.conversation-view.jsonl-viewer.tool-call:copy-tool-result",
    "conversations.conversation-view.jsonl-viewer.tool-call.ask-user-question:change-answers",
    "conversations.conversation-view.jsonl-viewer.user-text:copy-user-text",
    "conversations.conversation-view.jsonl-viewer.user-text:raw-text-toggle",
    "conversations.conversation-view.rewind:rewind",
    "conversations.conversation-view.rewind:fork-from-message"
  ]
}

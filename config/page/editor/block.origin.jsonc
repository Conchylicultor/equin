// @hash 508f5b01245d
{
  // Item: "<key>" (terse; <key> is "<pluginId>:<id>")
  // Hide: { "item": "<key>", "hidden": true }
  // Spacer (gap): { "type": "spacer", "id": "<unique-id>" } — grows to push every item after it to the far end of the row (title left, chips right); at most one per slot. Use it instead of a second slot.
  // Divider (rule): { "type": "divider", "id": "<unique-id>" } — a hairline rule between the items either side of it, turned to the slot's flow (flat in a column such as a sidebar's footer rows, upright in a row such as a toolbar).
  // Group: { "type": "header", "label": "<title>", "collapsed": false, "items": [ "<key>", … ] }
  // Overflow (⋯ menu): { "type": "overflow", "id": "<unique-id>", "items": [ "<key>", … ] }
  "items": [
    "page.annotations.agent-notes:agent-note",
    "page.annotations.human-notes:context",
    "page.annotations.instructions:instructions",
    "page.annotations.private-notes:private-note",
    "page.annotations.todo:todo",
    "page.audio:audio",
    "page.bookmark:bookmark",
    "page.bulleted-list:bulleted-list",
    "page.callout:callout",
    "page.code-block:code-block",
    "page.divider:divider",
    "page.embed:embed",
    "page.file:file",
    "page.heading.heading-1:heading-1",
    "page.heading.heading-2:heading-2",
    "page.heading.heading-3:heading-3",
    "page.image:image",
    "page.map:map",
    "page.math.equation:equation",
    "page.numbered-list:numbered-list",
    "page.page-link:page-link",
    "page.place:place",
    "page.prompt.block:prompt",
    "page.prototype:prototype",
    "page.quote:quote",
    "page.sub-page:page",
    "page.table:table",
    "page.text:text",
    "page.to-do:to-do",
    "page.toggle:toggle",
    "page.video:video"
  ]
}

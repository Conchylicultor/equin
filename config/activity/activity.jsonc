// @hash 6ec84829688d
{
  // Recent activity — tasks, conversations and pages in ONE list (the
  // `activity` union), newest activity first. Each tab is nothing but a filter
  // on the base `type` field (the registered arms: task, conversation, page),
  // so every tab sorts, filters and groups by the same base fields. A rule
  // naming a kind's own field (a task's Track, a page's Starred) prunes the
  // other kinds out on the server.
  "views": [
    {
      // Every kind, interleaved, newest first.
      "id": "recent",
      "name": "Recent",
      "icon": "history",
      "view": {
        "type": "list",
        "sort": [{ "fieldId": "updatedAt", "direction": "desc" }]
      }
    },
    {
      "id": "tasks",
      "name": "Tasks",
      "icon": "task-alt",
      "view": {
        "type": "list",
        "sort": [{ "fieldId": "updatedAt", "direction": "desc" }],
        "filter": {
          "kind": "group",
          "id": "tasks",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "tasks-type",
              "fieldId": "type",
              "operatorId": "is",
              "value": "task"
            }
          ]
        }
      }
    },
    {
      "id": "conversations",
      "name": "Conversations",
      "icon": "forum",
      "view": {
        "type": "list",
        "sort": [{ "fieldId": "updatedAt", "direction": "desc" }],
        "filter": {
          "kind": "group",
          "id": "conversations",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "conversations-type",
              "fieldId": "type",
              "operatorId": "is",
              "value": "conversation"
            }
          ]
        }
      }
    },
    {
      "id": "pages",
      "name": "Pages",
      "icon": "description",
      "view": {
        "type": "list",
        "sort": [{ "fieldId": "updatedAt", "direction": "desc" }],
        "filter": {
          "kind": "group",
          "id": "pages",
          "conjunction": "and",
          "children": [
            {
              "kind": "rule",
              "id": "pages-type",
              "fieldId": "type",
              "operatorId": "is",
              "value": "page"
            }
          ]
        }
      }
    }
  ],
  "sortPresets": [],
  "filterPresets": [],
  "customColumns": []
}

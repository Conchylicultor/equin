{
  "showThinkingSummaries": true,
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__equin__query_db",
      "Bash(rg:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "EnterWorktree",
      "ExitWorktree"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Read|NotebookEdit|Agent|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null 2>&1 || { echo 'guards: bun is not on PATH, so no PreToolUse guard can run; every tool call is blocked until it is (an agent pane seeds PATH with the mise shims: runtime-tmux agentSessionPath)' >&2; exit 2; }; cd \"${EQUIN_GUARDS_ROOT:-${SINGULARITY_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}}\" && bun \"${EQUIN_GUARDS_ROOT:-${SINGULARITY_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}}/plugins/framework/plugins/tooling/plugins/guards/bin/guard.ts\" || { echo 'guards: the PreToolUse guard failed (above), so every tool call is blocked until it runs' >&2; exit 2; }"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${EQUIN_GUARDS_ROOT:-${SINGULARITY_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}}\" && bun \"${EQUIN_GUARDS_ROOT:-${SINGULARITY_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}}/plugins/framework/plugins/tooling/plugins/guards/bin/stop-guard.ts\""
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${EQUIN_GUARDS_ROOT:-${SINGULARITY_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}}\" && bun \"${EQUIN_GUARDS_ROOT:-${SINGULARITY_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}}/plugins/framework/plugins/tooling/plugins/guards/bin/stop-guard.ts\""
          }
        ]
      }
    ]
  }
}

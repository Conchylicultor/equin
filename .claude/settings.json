{
  "showThinkingSummaries": true,
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__equin__query_db",
      "Bash(rg:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "EnterWorktree",
      "ExitWorktree"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Read|NotebookEdit|Agent|ToolSearch|Grep|Glob|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${EQUIN_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}/plugins/framework/plugins/tooling/plugins/guards/plugins/agent-policy/bin/run-hook.sh\" \"${EQUIN_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}/plugins/framework/plugins/tooling/plugins/guards/bin/guard.ts\" || { echo 'guards: the PreToolUse guard could not run (above), so every tool call is blocked until it does' >&2; exit 2; }"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${EQUIN_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}/plugins/framework/plugins/tooling/plugins/guards/plugins/agent-policy/bin/run-hook.sh\" \"${EQUIN_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}/plugins/framework/plugins/tooling/plugins/guards/bin/stop-guard.ts\""
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${EQUIN_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}/plugins/framework/plugins/tooling/plugins/guards/plugins/agent-policy/bin/run-hook.sh\" \"${EQUIN_GUARDS_ROOT:-$CLAUDE_PROJECT_DIR}/plugins/framework/plugins/tooling/plugins/guards/bin/stop-guard.ts\""
          }
        ]
      }
    ]
  }
}
